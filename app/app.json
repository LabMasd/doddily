{
  "expo": {
    "name": "Doddily",
    "slug": "little-days",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "littledays",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F6F8",
    "ios": {
      "bundleIdentifier": "app.doddily",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.doddily",
      "adaptiveIcon": {
        "backgroundColor": "#1E2536",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F6F8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Doddily uses your location to show baby activities near you. It isn't stored or shared."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Doddily adds the classes you choose to your calendar.",
          "writeOnlyAccess": true,
          "writeOnlyCalendarPermission": "Doddily adds the classes you choose to your calendar. It never reads your events."
        }
      ],
      "expo-font",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6e5e6bd3-d2e6-488b-80d3-f8804abb9fc1"
      }
    },
    "owner": "labmasd",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6e5e6bd3-d2e6-488b-80d3-f8804abb9fc1"
    }
  }
}
